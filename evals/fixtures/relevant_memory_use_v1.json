{
  "schema_version": 1,
  "suite_id": "relevant-memory-use-paired-v1",
  "privacy_class": "SYNTHETIC",
  "contains_user_data": false,
  "training_eligible": false,
  "validation_for_training": false,
  "purpose": "Measure useful, natural, provenance-faithful use of shared history under paired and counterfactual Memory conditions.",
  "pair_contract": {
    "required_variants": ["relevant", "irrelevant", "none", "stale_conflicting", "partial"],
    "same_user_message_within_pair": true
  },
  "global_forbidden_meta_phrases": [
    "根据我的记忆",
    "根据记忆",
    "记忆显示",
    "系统提供的记忆",
    "检索到的记忆",
    "从记忆中"
  ],
  "manual_rubric": {
    "naturalness": "Sounds like an ordinary reply from someone with earned familiarity; no database or memory-system narration.",
    "usefulness": "The admitted history changes understanding or the next response in a way that helps this exact message.",
    "provenance_truth": "Every familiarity claim is entailed by the supplied history or current message.",
    "fabricated_familiarity": "No invented recurrence, identity, event, preference, or confidence.",
    "forced_callback": "History is not mentioned merely to prove it was remembered.",
    "ignored_relevant_history": "A clearly useful relevant item is not discarded in favor of a generic reply.",
    "current_message_precedence": "Current corrections and present intent override stale or conflicting history."
  },
  "cases": [
    {
      "case_id": "self-reflection-relevant",
      "pair_id": "self-reflection",
      "variant": "relevant",
      "user_message": "我感觉我又在自嗨了。",
      "memory_context": ["前几天用户说很多项目由 AI 完成，因此有“东西做了很多但自己没学进去”的感觉。"],
      "expected": {
        "required_any_groups": [["东西做了", "项目做了", "做了不少"], ["没学进去", "没学到", "没真正学会"]],
        "forbidden_phrases": ["一直都很依赖 AI", "根据"],
        "uncertainty_required": false,
        "max_output_chars": 100
      }
    },
    {
      "case_id": "self-reflection-irrelevant",
      "pair_id": "self-reflection",
      "variant": "irrelevant",
      "user_message": "我感觉我又在自嗨了。",
      "memory_context": ["用户喜欢酸味软糖。"],
