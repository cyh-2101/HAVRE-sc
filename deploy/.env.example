# Every image value must include an immutable sha256 digest.
HAVRE_API_IMAGE=owner-registry.example/havre@sha256:REPLACE_ME
HAVRE_API_IMAGE_DIGEST=sha256:REPLACE_ME
HAVRE_POSTGRES_IMAGE=owner-registry.example/postgres-pgvector@sha256:REPLACE_ME
HAVRE_CADDY_IMAGE=caddy@sha256:REPLACE_ME
HAVRE_OPERATIONS_IMAGE=owner-registry.example/havre-operations@sha256:REPLACE_ME

HAVRE_PUBLIC_HOST=havre.owner.example
HAVRE_TLS_EMAIL=owner@example.com
HAVRE_PROVIDER_ID=deterministic-local
HAVRE_RELEASE_MANIFEST_PATH=./release-manifest.json

# These paths point to local mode-600 files and are mounted as container secrets.
HAVRE_POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres-admin-password
HAVRE_MIGRATOR_DATABASE_URL_FILE=./secrets/migrator-database-url
HAVRE_APP_DATABASE_URL_FILE=./secrets/app-database-url
HAVRE_ERASURE_DATABASE_URL_FILE=./secrets/erasure-database-url
HAVRE_RELEASE_DATABASE_URL_FILE=./secrets/release-database-url
HAVRE_RESTORE_DATABASE_URL_FILE=./secrets/restore-target-database-url
HAVRE_OWNER_API_TOKEN_FILE=./secrets/owner-api-token
HAVRE_CONTEXT_DEVICE_BINDING_ID=windows:REPLACE_WITH_ENROLLED_DEVICE
HAVRE_CONTEXT_DEVICE_SECRET_FILE=./secrets/context-device-secret
