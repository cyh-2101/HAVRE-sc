HAVRE_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/havre
HAVRE_OWNER_ID=00000000-0000-7000-8000-000000000001
HAVRE_IDENTITY_ROOT=identity
HAVRE_PROVIDER_ID=deterministic-local
# Set HAVRE_PROVIDER_ID=self-hosted-openai-compatible to use the Stage 3
# owner-controlled llama.cpp service. Plain HTTP is accepted only on loopback.
HAVRE_SELF_HOSTED_BASE_URL=http://127.0.0.1:8080
HAVRE_SELF_HOSTED_MODEL_MANIFEST=mlsys/serving/manifests/qwen3-8b-q4-k-m.json
HAVRE_SELF_HOSTED_ENGINE_MANIFEST=mlsys/serving/manifests/llama-cpp-b10405-win-cuda-12.4-x64.json
# HAVRE_SELF_HOSTED_API_KEY is optional and is never persisted.
HAVRE_CONTEXT_TOKEN_BUDGET=4096
HAVRE_RESERVED_OUTPUT_TOKENS=256
HAVRE_INFERENCE_TIMEOUT_MS=20000
