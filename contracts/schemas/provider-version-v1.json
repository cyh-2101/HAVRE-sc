{
  "additionalProperties": false,
  "description": "Exact, content-free provenance for one verified serving target.",
  "properties": {
    "active_adapter_artifact_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Adapter Artifact Hash"
    },
    "active_adapter_version_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Adapter Version Id"
    },
    "execution_environment": {
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Execution Environment",
      "type": "string"
    },
    "model_artifact_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Artifact Hash"
    },
    "model_version_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Model Version Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provider_adapter_version_id": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Provider Adapter Version Id",
      "type": "string"
    },
    "provider_class": {
      "enum": [
        "local_test",
        "self_hosted",
        "cloud"
      ],
      "title": "Provider Class",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "runtime_attestation_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Attestation Hash"
    },
    "runtime_attestation_id": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Attestation Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "serving_config_version": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Serving Config Version",
      "type": "string"
    },
    "serving_engine": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Serving Engine",
      "type": "string"
    },
    "serving_engine_version": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Serving Engine Version",
      "type": "string"
    },
    "tokenizer_version_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Tokenizer Version Id",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "provider_class",
    "execution_environment",
    "provider_adapter_version_id",
    "serving_engine",
    "serving_engine_version",
    "serving_config_version",
    "model_version_id",
    "tokenizer_version_id"
  ],
  "title": "ProviderVersion",
  "type": "object"
}
