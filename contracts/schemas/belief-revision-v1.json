{
  "$defs": {
    "BeliefInitialStatus": {
      "enum": [
        "candidate",
        "active"
      ],
      "title": "BeliefInitialStatus",
      "type": "string"
    },
    "BeliefType": {
      "enum": [
        "fact",
        "preference",
        "value",
        "strength",
        "vulnerability",
        "pattern",
        "uncertainty"
      ],
      "title": "BeliefType",
      "type": "string"
    },
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "belief_id": {
      "format": "uuid",
      "title": "Belief Id",
      "type": "string"
    },
    "belief_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Belief Key",
      "type": "string"
    },
    "belief_type": {
      "$ref": "#/$defs/BeliefType"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "confidence_method": {
      "const": "owner-reviewed-v1",
      "default": "owner-reviewed-v1",
      "title": "Confidence Method",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_event_id": {
      "format": "uuid",
      "title": "Created Event Id",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "evidence_occurred_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Occurred From"
    },
    "evidence_occurred_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Occurred To"
    },
    "initial_status": {
      "$ref": "#/$defs/BeliefInitialStatus"
    },
    "learned_at": {
      "format": "date-time",
      "title": "Learned At",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "statement": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "supersedes_revision": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Revision"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    }
  },
  "required": [
    "owner_id",
    "revision",
    "belief_key",
    "statement",
    "belief_type",
    "confidence",
    "initial_status",
    "learned_at",
    "created_event_id",
    "trace_id",
    "data_policy"
  ],
  "title": "BeliefRevision",
  "type": "object"
}
