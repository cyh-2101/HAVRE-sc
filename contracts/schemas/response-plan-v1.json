{
  "$defs": {
    "ResponseObligation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "question",
            "request",
            "decision",
            "context"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "ResponseObligation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Historical Stage 13A baseline retained for evidence replay.",
  "properties": {
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "depth": {
      "enum": [
        "brief",
        "balanced",
        "detailed"
      ],
      "title": "Depth",
      "type": "string"
    },
    "intent": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "memory_need": {
      "enum": [
        "none",
        "possible",
        "required"
      ],
      "title": "Memory Need",
      "type": "string"
    },
    "memory_query": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Query"
    },
    "mode": {
      "enum": [
        "talk",
        "guide",
        "prepare",
        "reflect"
      ],
      "title": "Mode",
      "type": "string"
    },
    "must_address": {
      "items": {
        "$ref": "#/$defs/ResponseObligation"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Must Address",
      "type": "array"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "planner_version": {
      "const": "response-planner-v1",
      "default": "response-planner-v1",
      "title": "Planner Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "stance": {
      "enum": [
        "warm",
        "warm_firm",
        "direct",
        "analytical"
      ],
      "title": "Stance",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "owner_id",
    "mode",
    "intent",
    "must_address",
    "memory_need",
    "depth",
    "stance",
    "uncertainty",
    "source_refs"
  ],
  "title": "ResponsePlanV1",
  "type": "object"
}
