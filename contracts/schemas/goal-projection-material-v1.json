{
  "$defs": {
    "GoalPriority": {
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "title": "GoalPriority",
      "type": "string"
    },
    "GoalProjectionDataPolicy": {
      "additionalProperties": false,
      "description": "Exact DataPolicy material included in a Goal projection digest.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "policy_revision_id",
        "privacy_class",
        "memory_eligible",
        "training_eligible",
        "cloud_eligible",
        "policy_version",
        "decision_source",
        "authorization_ref"
      ],
      "title": "GoalProjectionDataPolicy",
      "type": "object"
    },
    "GoalStatus": {
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ],
      "title": "GoalStatus",
      "type": "string"
    },
    "GoalTrack": {
      "enum": [
        "reality",
        "inner_life"
      ],
      "title": "GoalTrack",
      "type": "string"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete and only material admitted to a Goal content hash.",
  "properties": {
    "data_policy": {
      "$ref": "#/$defs/GoalProjectionDataPolicy"
    },
    "goal_id": {
      "format": "uuid",
      "title": "Goal Id",
      "type": "string"
    },
    "last_event_id": {
      "format": "uuid",
      "title": "Last Event Id",
      "type": "string"
    },
    "next_action": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Action"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/GoalPriority"
    },
    "review_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review At"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/GoalStatus"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "track": {
      "$ref": "#/$defs/GoalTrack"
    },
    "why": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Why",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "goal_id",
    "owner_id",
    "track",
    "title",
    "why",
    "priority",
    "status",
    "next_action",
    "review_at",
    "revision",
    "last_event_id",
    "data_policy"
  ],
  "title": "GoalProjectionMaterial",
  "type": "object"
}
