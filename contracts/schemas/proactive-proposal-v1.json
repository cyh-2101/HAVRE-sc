{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_channels": {
      "default": [
        "web_inbox"
      ],
      "items": {
        "const": "web_inbox",
        "type": "string"
      },
      "title": "Candidate Channels",
      "type": "array"
    },
    "category": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Category",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "deduplication_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Deduplication Key",
      "type": "string"
    },
    "earliest_eligible_at": {
      "format": "date-time",
      "title": "Earliest Eligible At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "intended_benefit": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Intended Benefit",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "reason_code": {
      "pattern": "^[a-z][a-z0-9_]{1,95}$",
      "title": "Reason Code",
      "type": "string"
    },
    "reason_summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason Summary",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "simulation_only": {
      "const": true,
      "default": true,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "status": {
      "const": "created",
      "default": "created",
      "title": "Status",
      "type": "string"
    },
    "subject_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Subject Refs",
      "type": "array"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "trigger_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Trigger Refs",
      "type": "array"
    }
  },
  "required": [
    "owner_id",
    "category",
    "trigger_refs",
    "reason_code",
    "reason_summary",
    "intended_benefit",
    "evidence_refs",
    "data_policy",
    "earliest_eligible_at",
    "expires_at",
    "deduplication_key",
    "trace_id"
  ],
  "title": "ProactiveProposal",
  "type": "object"
}
