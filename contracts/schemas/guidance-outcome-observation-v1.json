{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "OutcomeHelpfulness": {
      "enum": [
        "helpful",
        "not_helpful",
        "uncertain",
        "not_asked"
      ],
      "title": "OutcomeHelpfulness",
      "type": "string"
    },
    "OutcomeTriState": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "title": "OutcomeTriState",
      "type": "string"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_attempted": {
      "$ref": "#/$defs/OutcomeTriState"
    },
    "action_record_id": {
      "format": "uuid",
      "title": "Action Record Id",
      "type": "string"
    },
    "consented": {
      "const": true,
      "default": true,
      "title": "Consented",
      "type": "boolean"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_event_id": {
      "format": "uuid",
      "title": "Created Event Id",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "evidence_snapshot": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Evidence Snapshot",
      "type": "array"
    },
    "guidance_event_id": {
      "format": "uuid",
      "title": "Guidance Event Id",
      "type": "string"
    },
    "helpfulness": {
      "$ref": "#/$defs/OutcomeHelpfulness",
      "default": "not_asked"
    },
    "intervention_decision_id": {
      "format": "uuid",
      "title": "Intervention Decision Id",
      "type": "string"
    },
    "later_regret": {
      "default": "not_asked",
      "enum": [
        "yes",
        "no",
        "unsure",
        "not_asked"
      ],
      "title": "Later Regret",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "observation_window_ended_at": {
      "format": "date-time",
      "title": "Observation Window Ended At",
      "type": "string"
    },
    "observation_window_started_at": {
      "format": "date-time",
      "title": "Observation Window Started At",
      "type": "string"
    },
    "outcome_observation_id": {
      "format": "uuid",
      "title": "Outcome Observation Id",
      "type": "string"
    },
    "outcome_record_id": {
      "format": "uuid",
      "title": "Outcome Record Id",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "planned_scene_status": {
      "enum": [
        "completed",
        "partial",
        "abandoned",
        "cancelled",
        "unknown"
      ],
      "title": "Planned Scene Status",
      "type": "string"
    },
    "reflection_record_id": {
      "format": "uuid",
      "title": "Reflection Record Id",
      "type": "string"
    },
    "reporter": {
      "const": "user_self_report",
      "default": "user_self_report",
      "title": "Reporter",
      "type": "string"
    },
    "scene_session_id": {
      "format": "uuid",
      "title": "Scene Session Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "too_forceful": {
      "$ref": "#/$defs/OutcomeTriState",
      "default": "unknown"
    },
    "too_passive": {
      "$ref": "#/$defs/OutcomeTriState",
      "default": "unknown"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "scene_session_id",
    "intervention_decision_id",
    "guidance_event_id",
    "action_record_id",
    "outcome_record_id",
    "reflection_record_id",
    "observation_window_started_at",
    "observation_window_ended_at",
    "action_attempted",
    "planned_scene_status",
    "limitations",
    "evidence_snapshot",
    "created_event_id",
    "trace_id",
    "data_policy"
  ],
  "title": "GuidanceOutcomeObservation",
  "type": "object"
}
