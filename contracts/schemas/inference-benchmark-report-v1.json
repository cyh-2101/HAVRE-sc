    "ResourceObservation": {
      "additionalProperties": false,
      "description": "One resource metric with explicit evidence or explicit unavailability.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "unit"
      ],
      "title": "ResourceObservation",
      "type": "object"
    },
    "ResourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cpu_percent": {
          "$ref": "#/$defs/ResourceObservation"
        },
        "gpu_utilization_percent": {
          "$ref": "#/$defs/ResourceObservation"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "ram_used_bytes": {
          "$ref": "#/$defs/ResourceObservation"
        },
        "vram_peak_used_bytes": {
          "$ref": "#/$defs/ResourceObservation"
        },
        "vram_used_bytes": {
          "$ref": "#/$defs/ResourceObservation"
        }
      },
      "required": [
        "observed_at",
        "cpu_percent",
        "ram_used_bytes",
        "gpu_utilization_percent",
        "vram_used_bytes",
        "vram_peak_used_bytes"
      ],
      "title": "ResourceSnapshot",
      "type": "object"
    },
    "RuntimeVerification": {
      "additionalProperties": false,
      "description": "Typed evidence that a benchmark was bound to one running binary/config.",
