      "required": [
        "manifest_id",
        "provider_id",
        "provider_class",
        "execution_environment",
        "model_version_id",
        "provider_adapter_version_id",
        "tokenizer_version_id",
        "serving_config_version",
        "serving_engine",
        "serving_engine_version",
        "upstream_model_id",
