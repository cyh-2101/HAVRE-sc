{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    },
    "SceneRecordType": {
      "enum": [
        "signal",
        "intervention",
        "action",
        "outcome",
        "reflection"
      ],
      "title": "SceneRecordType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "artifact_kind": {
      "anyOf": [
        {
          "const": "intervention_decision",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Kind"
    },
    "artifact_revision": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Revision"
    },
    "assistant_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assistant Event Id"
    },
    "causal_predecessor_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causal Predecessor Id"
    },
    "content": {
      "additionalProperties": true,
      "title": "Content",
      "type": "object"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "phase": {
      "enum": [
        "before",
        "during",
        "after"
      ],
      "title": "Phase",
      "type": "string"
    },
    "record_type": {
      "$ref": "#/$defs/SceneRecordType"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "scene_record_id": {
      "format": "uuid",
      "title": "Scene Record Id",
      "type": "string"
    },
    "scene_session_id": {
      "format": "uuid",
      "title": "Scene Session Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence_number": {
      "exclusiveMinimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "source": {
      "enum": [
        "owner_self_report",
        "web_simulation",
        "intervention_policy"
      ],
      "title": "Source",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "uncertainty_note": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Note"
    }
  },
  "required": [
    "owner_id",
    "scene_session_id",
    "record_type",
    "phase",
    "sequence_number",
    "occurred_at",
    "event_id",
    "source",
    "content",
    "trace_id",
    "data_policy"
  ],
  "title": "SceneRecord",
  "type": "object"
}
