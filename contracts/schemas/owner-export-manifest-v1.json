{
  "$defs": {
    "ExportArtifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "pattern": "^[a-z0-9][a-z0-9._/-]{1,500}$",
          "title": "Relative Path",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "media_type",
        "sha256",
        "size_bytes",
        "row_count"
      ],
      "title": "ExportArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ExportArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "database_schema_migrations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Database Schema Migrations",
      "type": "array"
    },
    "export_id": {
      "format": "uuid",
      "title": "Export Id",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "owner_id",
    "database_schema_migrations",
    "artifacts"
  ],
  "title": "OwnerExportManifest",
  "type": "object"
}
