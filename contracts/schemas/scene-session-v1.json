{
  "$defs": {
    "AnticipatedTrigger": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "uncertainty_note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Note"
        }
      },
      "required": [
        "label"
      ],
      "title": "AnticipatedTrigger",
      "type": "object"
    },
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    },
    "SceneGoal": {
      "additionalProperties": false,
      "properties": {
        "minimum_success": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Minimum Success",
          "type": "string"
        },
        "objective": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "owner_chosen": {
          "const": true,
          "default": true,
          "title": "Owner Chosen",
          "type": "boolean"
        }
      },
      "required": [
        "objective",
        "minimum_success"
      ],
      "title": "SceneGoal",
      "type": "object"
    },
    "ScenePhase": {
      "enum": [
        "before",
        "during",
        "after",
        "closed"
      ],
      "title": "ScenePhase",
      "type": "string"
    },
    "SceneSituation": {
      "additionalProperties": false,
      "properties": {
        "known_facts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Known Facts",
          "type": "array"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "uncertainty_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Uncertainty Notes",
          "type": "array"
        }
      },
      "required": [
        "summary"
      ],
      "title": "SceneSituation",
      "type": "object"
    },
    "SceneStatus": {
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "abandoned",
        "cancelled"
      ],
      "title": "SceneStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anticipated_triggers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnticipatedTrigger"
      },
      "title": "Anticipated Triggers",
      "type": "array"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_event_id": {
      "format": "uuid",
      "title": "Created Event Id",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "last_event_id": {
      "format": "uuid",
      "title": "Last Event Id",
      "type": "string"
    },
    "opened_session_id": {
      "format": "uuid",
      "title": "Opened Session Id",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/ScenePhase"
    },
    "planned_goal": {
      "$ref": "#/$defs/SceneGoal"
    },
    "planned_start_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Start At"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "scene_session_id": {
      "format": "uuid",
      "title": "Scene Session Id",
      "type": "string"
    },
    "scene_type": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Scene Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "situation": {
      "$ref": "#/$defs/SceneSituation"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/SceneStatus"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "opened_session_id",
    "scene_type",
    "situation",
    "planned_goal",
    "phase",
    "status",
    "revision",
    "created_event_id",
    "last_event_id",
    "trace_id",
    "data_policy"
  ],
  "title": "SceneSession",
  "type": "object"
}
