{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "delivery_authority": {
      "const": false,
      "default": false,
      "title": "Delivery Authority",
      "type": "boolean"
    },
    "evidence_event_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "outreach_authority": {
      "const": false,
      "default": false,
      "title": "Outreach Authority",
      "type": "boolean"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "proposal_kind": {
      "enum": [
        "pattern_check",
        "unresolved_contradiction",
        "progress_recognition",
        "follow_up"
      ],
      "title": "Proposal Kind",
      "type": "string"
    },
    "reflection_proposal_id": {
      "format": "uuid",
      "title": "Reflection Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "simulation_only": {
      "const": true,
      "default": true,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "source_snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Hash",
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "transform_version": {
      "const": "deterministic-reflection-v1",
      "default": "deterministic-reflection-v1",
      "title": "Transform Version",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "job_id",
    "proposal_kind",
    "summary",
    "evidence_event_ids",
    "source_snapshot_hash",
    "data_policy",
    "trace_id"
  ],
  "title": "ReflectionProposal",
  "type": "object"
}
