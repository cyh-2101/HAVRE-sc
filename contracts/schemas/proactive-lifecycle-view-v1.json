          "type": "string"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "effective_data_policy": {
          "$ref": "#/$defs/DataPolicy"
        },
        "evidence_sections": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 1,
          "title": "Evidence Sections",
          "type": "array"
        },
        "interruption_decision_id": {
          "format": "uuid",
          "title": "Interruption Decision Id",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "prefix_sections": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 2,
