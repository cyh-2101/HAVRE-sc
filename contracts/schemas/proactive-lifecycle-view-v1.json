        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "purpose": {
          "const": "authorized_proactive_rendering",
          "default": "authorized_proactive_rendering",
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "strategy_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "proposal_id",
        "interruption_decision_id",
        "strategy_version",
        "prefix_sections",
        "evidence_sections",
        "effective_data_policy",
        "trace_id"
      ],
      "title": "ProactiveContextPack",
      "type": "object"
