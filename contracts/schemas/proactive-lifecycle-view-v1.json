{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "DeliveryAttempt": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "local-web-inbox-v1",
          "default": "local-web-inbox-v1",
          "title": "Adapter Version",
          "type": "string"
        },
        "attempt_number": {
          "const": 1,
          "default": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "channel": {
          "const": "web_inbox",
          "default": "web_inbox",
          "title": "Channel",
          "type": "string"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "delivery_attempt_id": {
          "format": "uuid",
          "title": "Delivery Attempt Id",
          "type": "string"
        },
        "external_delivery_authorized": {
          "const": false,
          "default": false,
          "title": "External Delivery Authorized",
          "type": "boolean"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "idempotency_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "interruption_decision_id": {
          "format": "uuid",
          "title": "Interruption Decision Id",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "provider_receipt_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Receipt Id"
        },
        "rendering_id": {
          "format": "uuid",
          "title": "Rendering Id",
          "type": "string"
        },
        "retryable": {
          "const": false,
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "simulation_only": {
          "const": true,
          "default": true,
          "title": "Simulation Only",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "delivered",
            "failed",
            "expired",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        },
        "visible_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible At"
        }
      },
      "required": [
        "owner_id",
        "proposal_id",
        "interruption_decision_id",
        "rendering_id",
        "idempotency_key",
        "status",
        "trace_id"
      ],
      "title": "DeliveryAttempt",
      "type": "object"
    },
    "InterruptionDecision": {
      "additionalProperties": false,
      "properties": {
        "constitution_version_id": {
          "title": "Constitution Version Id",
          "type": "string"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/InterruptionOutcome"
        },
        "defer_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defer Until"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "external_delivery_authorized": {
          "const": false,
          "default": false,
          "title": "External Delivery Authorized",
          "type": "boolean"
        },
        "human_explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Human Explanation",
          "type": "string"
        },
        "identity_version_id": {
          "title": "Identity Version Id",
          "type": "string"
        },
        "inputs_snapshot": {
          "$ref": "#/$defs/InterruptionInputs"
        },
        "interruption_decision_id": {
          "format": "uuid",
          "title": "Interruption Decision Id",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "policy_version": {
          "const": "interruption-policy-conservative-v1",
          "default": "interruption-policy-conservative-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "preference_revision_id": {
          "format": "uuid",
          "title": "Preference Revision Id",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "rendering_constraints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rendering Constraints",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "simulation_only": {
          "const": true,
          "default": true,
          "title": "Simulation Only",
          "type": "boolean"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "proposal_id",
        "decision",
        "reason_codes",
        "human_explanation",
        "preference_revision_id",
        "constitution_version_id",
        "identity_version_id",
        "inputs_snapshot",
        "expires_at",
        "rendering_constraints",
        "trace_id"
      ],
      "title": "InterruptionDecision",
      "type": "object"
    },
    "InterruptionInputs": {
      "additionalProperties": false,
      "properties": {
        "category_budget_result": {
          "enum": [
            "available",
            "exhausted",
            "unresolved"
          ],
          "title": "Category Budget Result",
          "type": "string"
        },
        "category_permission": {
          "enum": [
            "allowed",
            "denied",
            "confirmation_required",
            "unresolved"
          ],
          "title": "Category Permission",
          "type": "string"
        },
        "channel_eligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "unresolved"
          ],
          "title": "Channel Eligibility",
          "type": "string"
        },
        "cooldown_result": {
          "enum": [
            "clear",
            "active",
            "unresolved"
          ],
          "title": "Cooldown Result",
          "type": "string"
        },
        "deduplication_result": {
          "enum": [
            "unique",
            "duplicate",
            "unresolved"
          ],
          "title": "Deduplication Result",
          "type": "string"
        },
        "expiration_result": {
          "enum": [
            "eligible",
            "not_yet",
            "expired"
          ],
          "title": "Expiration Result",
          "type": "string"
        },
        "global_budget_result": {
          "enum": [
            "available",
            "exhausted",
            "unresolved"
          ],
          "title": "Global Budget Result",
          "type": "string"
        },
        "global_permission": {
          "enum": [
            "enabled",
            "disabled",
            "unresolved"
          ],
          "title": "Global Permission",
          "type": "string"
        },
        "prior_response_result": {
          "default": "none",
          "enum": [
            "none",
            "responded",
            "dismissed",
            "snoozed",
            "non_response",
            "stopped"
          ],
          "title": "Prior Response Result",
          "type": "string"
        },
        "privacy_eligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "unresolved"
          ],
          "title": "Privacy Eligibility",
          "type": "string"
        },
        "quiet_hours_result": {
          "enum": [
            "inside",
            "outside",
            "unresolved"
          ],
          "title": "Quiet Hours Result",
          "type": "string"
        },
        "subject_stop_result": {
          "enum": [
            "clear",
            "stopped"
          ],
          "title": "Subject Stop Result",
          "type": "string"
        }
      },
      "required": [
        "global_permission",
        "category_permission",
        "quiet_hours_result",
        "global_budget_result",
        "category_budget_result",
        "cooldown_result",
        "deduplication_result",
        "expiration_result",
        "channel_eligibility",
        "privacy_eligibility",
        "subject_stop_result"
      ],
      "title": "InterruptionInputs",
      "type": "object"
    },
    "InterruptionOutcome": {
      "enum": [
        "SEND_NOW",
        "DEFER",
        "DROP",
        "REQUEST_OWNER_CONFIRMATION"
      ],
      "title": "InterruptionOutcome",
      "type": "string"
    },
    "PreviewPolicy": {
      "enum": [
        "none",
        "generic_private"
      ],
      "title": "PreviewPolicy",
      "type": "string"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    },
    "ProactiveContextPack": {
      "additionalProperties": false,
      "properties": {
        "builder_version": {
          "const": "proactive-context-builder-v1",
          "default": "proactive-context-builder-v1",
