{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "GenerationSettings": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stop": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stop",
          "type": "array"
        },
        "temperature": {
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Top P",
          "type": "number"
        }
      },
      "required": [
        "max_output_tokens",
        "temperature",
        "top_p"
      ],
      "title": "GenerationSettings",
      "type": "object"
    },
    "InferenceConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_execution_environments": {
          "items": {
            "enum": [
              "local",
              "cloud"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Execution Environments",
          "type": "array"
        },
        "effective_data_policy": {
          "$ref": "#/$defs/DataPolicy"
        },
        "stream": {
          "title": "Stream",
          "type": "boolean"
        },
        "timeout_ms": {
          "exclusiveMinimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "stream",
        "timeout_ms",
        "effective_data_policy",
        "allowed_execution_environments"
      ],
      "title": "InferenceConstraints",
      "type": "object"
    },
    "InferenceMessage": {
      "additionalProperties": false,
      "properties": {
        "content_parts": {
          "items": {
            "discriminator": {
              "mapping": {
                "text": "#/$defs/TextContentPart"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextContentPart"
              }
            ]
          },
          "minItems": 1,
          "title": "Content Parts",
          "type": "array"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "role",
        "content_parts",
        "source_refs"
      ],
      "title": "InferenceMessage",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    },
    "TextContentPart": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextContentPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brain_role": {
      "const": "personal",
      "default": "personal",
      "title": "Brain Role",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/InferenceConstraints"
    },
    "context_pack_id": {
      "format": "uuid",
      "title": "Context Pack Id",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/GenerationSettings"
    },
    "inference_request_id": {
      "format": "uuid",
      "title": "Inference Request Id",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/InferenceMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    },
    "model_target_logical_profile": {
      "const": "personal-balanced",
      "default": "personal-balanced",
      "title": "Model Target Logical Profile",
      "type": "string"
    },
    "purpose": {
      "const": "companion_response",
      "default": "companion_response",
      "title": "Purpose",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "response_format": {
      "const": "text",
      "default": "text",
      "title": "Response Format",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "messages",
    "context_pack_id",
    "generation",
    "constraints",
    "metadata"
  ],
  "title": "InferenceRequest",
  "type": "object"
}
