{
  "additionalProperties": false,
  "properties": {
    "actor": {
      "const": "product_owner",
      "default": "product_owner",
      "title": "Actor",
      "type": "string"
    },
    "approval_scope": {
      "enum": [
        "infrastructure_production_release",
        "personalized_adapter_release"
      ],
      "title": "Approval Scope",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "release_approval_id": {
      "format": "uuid",
      "title": "Release Approval Id",
      "type": "string"
    },
    "release_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Release Manifest Hash",
      "type": "string"
    },
    "release_manifest_id": {
      "format": "uuid",
      "title": "Release Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "owner_id",
    "release_manifest_id",
    "release_manifest_hash",
    "approval_scope",
    "decision",
    "rationale"
  ],
  "title": "ReleaseApprovalRecord",
  "type": "object"
}
