{
  "$defs": {
    "DataPolicy": {
      "additionalProperties": false,
      "description": "A complete policy snapshot attached to each personal artifact.\n\nStage 1 deliberately rejects training eligibility. Turning it on is a\nmaterial governance change and cannot arrive as a request-level flag.",
      "properties": {
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Ref"
        },
        "cloud_eligible": {
          "title": "Cloud Eligible",
          "type": "boolean"
        },
        "decision_source": {
          "enum": [
            "owner_default",
            "owner_explicit",
            "derived_conservative"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "memory_eligible": {
          "title": "Memory Eligible",
          "type": "boolean"
        },
        "policy_revision_id": {
          "format": "uuid",
          "title": "Policy Revision Id",
          "type": "string"
        },
        "policy_version": {
          "const": "data-policy-v1",
          "default": "data-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "training_eligible": {
          "const": false,
          "default": false,
          "title": "Training Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "privacy_class",
        "memory_eligible",
        "cloud_eligible",
        "decision_source"
      ],
      "title": "DataPolicy",
      "type": "object"
    },
    "InterventionBranch": {
      "enum": [
        "safety_first",
        "clarification",
        "recovery",
        "minimum_action",
        "preparation",
        "reflection"
      ],
      "title": "InterventionBranch",
      "type": "string"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "NORMAL",
        "PRIVATE",
        "HIGHLY_PRIVATE",
        "LOCAL_ONLY"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "branch": {
      "$ref": "#/$defs/InterventionBranch"
    },
    "clarification_question": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification Question"
    },
    "constitution_version_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Constitution Version Id",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_policy": {
      "$ref": "#/$defs/DataPolicy"
    },
    "guidance": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Guidance",
      "type": "string"
    },
    "identity_version_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Identity Version Id",
      "type": "string"
    },
    "input_event_id": {
      "format": "uuid",
      "title": "Input Event Id",
      "type": "string"
    },
    "input_record_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Record Id"
    },
    "intervention_decision_id": {
      "format": "uuid",
      "title": "Intervention Decision Id",
      "type": "string"
    },
    "minimum_action": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Action"
    },
    "outreach_authorized": {
      "const": false,
      "default": false,
      "title": "Outreach Authorized",
      "type": "boolean"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "phase": {
      "enum": [
        "before",
        "during",
        "after"
      ],
      "title": "Phase",
      "type": "string"
    },
    "policy_release_status": {
      "const": "candidate_owner_acceptance",
      "default": "candidate_owner_acceptance",
      "title": "Policy Release Status",
      "type": "string"
    },
    "policy_version": {
      "const": "intervention-policy-sim-v1",
      "default": "intervention-policy-sim-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "recommended_intervention": {
      "enum": [
        "prioritize_safety_and_help",
        "clarify_before_pressure",
        "support_recovery_with_restart",
        "smallest_viable_action",
        "prepare_with_user_owned_plan",
        "reflect_without_self_judgment"
      ],
      "title": "Recommended Intervention",
      "type": "string"
    },
    "required_constraints": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Constraints",
      "type": "array"
    },
    "response_style": {
      "enum": [
        "calm_direct",
        "warm_firm",
        "supportive_recovery",
        "curious_reflective"
      ],
      "title": "Response Style",
      "type": "string"
    },
    "scene_revision": {
      "exclusiveMinimum": 0,
      "title": "Scene Revision",
      "type": "integer"
    },
    "scene_session_id": {
      "format": "uuid",
      "title": "Scene Session Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "simulation_only": {
      "const": true,
      "default": true,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "values_version_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Values Version Id",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "scene_session_id",
    "scene_revision",
    "input_event_id",
    "phase",
    "constitution_version_id",
    "identity_version_id",
    "values_version_id",
    "branch",
    "recommended_intervention",
    "response_style",
    "guidance",
    "reason_codes",
    "required_constraints",
    "trace_id",
    "data_policy"
  ],
  "title": "InterventionDecision",
  "type": "object"
}
